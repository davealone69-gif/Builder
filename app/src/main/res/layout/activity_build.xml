<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f1117"
    android:padding="16dp">

    <!-- ═══════ HEADER ═══════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SwarmBuilder"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Describe your app, the swarm builds it."
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <!-- ═══════ PROMPT INPUT ═══════ -->
    <EditText
        android:id="@+id/input_prompt"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="e.g. A music player with playlists, dark mode, and offline support…"
        android:gravity="top"
        android:textColor="#ffffff"
        android:textColorHint="#555555"
        android:background="@drawable/input_bg"
        android:padding="14dp"
        android:textSize="15sp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp"/>

    <!-- ═══════ BUILD BUTTON ═══════ -->
    <Button
        android:id="@+id/btn_build"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="🚀 Build My App"
        android:textColor="#ffffff"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="#6c5ce7"
        android:layout_marginBottom="16dp"/>

    <!-- ═══════ PHASE STATUS ═══════ -->
    <TextView
        android:id="@+id/text_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting…"
        android:textColor="#6c5ce7"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- ═══════ AGENT STATUS ROW ═══════ -->
    <LinearLayout
        android:id="@+id/container_agent_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:gravity="center">
        <!-- Filled dynamically: each agent gets a chip -->
    </LinearLayout>

    <!-- ═══════ ACTION BUTTONS (hidden until build succeeds) ═══════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_download_apk"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📥 Install APK"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#00cec9"
            android:visibility="gone"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_push_git"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🚀 Push to Git"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#e17055"
            android:visibility="gone"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_view_source"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="📂 View Generated Source Files"
        android:textColor="#ffffff"
        android:textSize="13sp"
        android:backgroundTint="#2d3436"
        android:visibility="gone"
        android:layout_marginBottom="12dp"/>

    <!-- ═══════ LOG LIST ═══════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agent Activity"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <ListView
        android:id="@+id/list_logs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1a1d27"
        android:divider="#2e3344"
        android:dividerHeight="1dp"
        android:padding="8dp"/>

</LinearLayout>
