<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gap="16dp">

        <!-- ══════ HEADER ═══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ SwarmBuilder Settings"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- ═══════ GLOBAL API KEYS ═══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 Global API Keys (free to get)"
            android:textColor="#6c5ce7"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/input_groq_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Groq API Key (free at console.groq.com)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <EditText android:id="@+id/input_hf_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hugging Face Token (free at huggingface.co)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <EditText android:id="@+id/input_openrouter_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenRouter API Key (free at openrouter.ai)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <!-- ══════ DEFAULT PROVIDER ═══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Default LLM Provider (fallback)"
            android:textColor="#6c5ce7"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <Spinner android:id="@+id/spinner_provider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_bg"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- ═══════ GITHUB ══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" GitHub Settings"
            android:textColor="#6c5ce7"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText android:id="@+id/input_github_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="GitHub Personal Access Token (repo scope)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <EditText android:id="@+id/input_github_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="GitHub Username"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <EditText android:id="@+id/input_github_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Repo name (e.g. my-app)"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- ═══════ PER-AGENT CONFIG ═══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 Per-Agent AI Config"
            android:textColor="#6c5ce7"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Each agent can use a different AI. Leave fields blank to use defaults."
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <!-- ─── Architect ─── -->
        <include layout="@layout/agent_config_section"
            android:id="@+id/section_architect"/>

        <!-- (In real app, duplicate the agent_config_section 3 times with different IDs.
             For brevity, here's the inline version:) -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📐 Architect"
            android:textColor="#00cec9"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Spinner android:id="@+id/spinner_arch_provider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/input_bg"
            android:padding="8dp"/>

        <EditText android:id="@+id/input_arch_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (blank = default for provider)"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"/>

        <EditText android:id="@+id/input_arch_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom URL (blank = provider default). e.g. http://192.168.1.10:11434"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"/>

        <EditText android:id="@+id/input_arch_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key override (blank = use global key)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- ─── Coder ─── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💻 Coder"
            android:textColor="#fd79a8"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Spinner android:id="@+id/spinner_coder_provider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/input_bg"
            android:padding="8dp"/>

        <EditText android:id="@+id/input_coder_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (blank = default)"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"/>

        <EditText android:id="@+id/input_coder_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom URL (blank = provider default)"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"/>

        <EditText android:id="@+id/input_coder_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key override (blank = use global key)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:layout_marginBottom="12dp"/>

        <!-- ─── Reviewer ─── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔧 Reviewer / Fixer"
            android:textColor="#fdcb6e"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Spinner android:id="@+id/spinner_reviewer_provider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/input_bg"
            android:padding="8dp"/>

        <EditText android:id="@+id/input_reviewer_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (blank = default)"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"/>

        <EditText android:id="@+id/input_reviewer_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom URL (blank = provider default)"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"/>

        <EditText android:id="@+id/input_reviewer_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key override (blank = use global key)"
            android:inputType="textPassword"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:background="@drawable/input_bg"
            android:padding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- ═══════ HELP TEXT ═══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Tip: Use a custom URL to point at a web chatbot proxy (like LiteLLM or a FreeGPT server). This lets you use ChatGPT/Gemini/Claude web interfaces as your AI backend."
            android:textColor="#aaaaaa"
            android:textSize="12sp"
            android:background="#2a2a3e"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- ═══════ SAVE BUTTON ═══════ -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="💾 Save Settings"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:backgroundTint="#6c5ce7"
            android:onClick="onSaveClicked"/>

    </LinearLayout>
</ScrollView>
